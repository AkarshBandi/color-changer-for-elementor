# Files that belong in the repository but not in the distributed plugin.
#
# `wp dist-archive` and the WordPress.org SVN deploy workflows read this file.
# Everything listed here is development scaffolding: shipping it would put
# global-namespace test stubs, CI config and 800 KB of documentation into every
# install, and WordPress.org's Plugin Check would rightly complain about all of
# it.

# Version control and CI
.git
.github
.gitignore
.distignore

# Dependencies and build output
vendor
node_modules
composer.json
composer.lock

# Tests. The bootstrap deliberately declares WordPress functions in the global
# namespace, which is correct for a stub and wrong in a shipped plugin.
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache

# Engineering documentation. The product readme.txt is what users read; these
# are for whoever maintains the plugin.
docs

# Editor and OS noise
.DS_Store
.idea
.vscode
*.bak
